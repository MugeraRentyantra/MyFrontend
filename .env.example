# Copy to .env.local and adjust. Only VITE_* variables reach the browser.

# Base URL of the backend API (all routes live under /api/v1).
# Relative is recommended so the refresh-token cookie stays first-party.
VITE_API_URL=/api/v1

# Optional: proxy /api to a local backend during `npm run dev` (used with a relative VITE_API_URL).
# VITE_API_PROXY_TARGET=http://localhost:5000

# true  = run against the in-browser mock API (MSW) with seeded demo data.
# false = call the real backend.
VITE_USE_MOCKS=true

# Simulated network latency for the mock API, in milliseconds.
VITE_MOCK_LATENCY_MS=350

# Payment gateway adapter used by the checkout screen: mock | razorpay
VITE_PAYMENT_PROVIDER=mock

# Branding and support contact shown in the UI.
VITE_APP_NAME=Internship Portal
VITE_SUPPORT_EMAIL=support@internshipportal.dev
